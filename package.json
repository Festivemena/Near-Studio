{
  "name": "near-studio",
  "displayName": "Near Studio",
  "description": "A comprehensive VS Code extension for developing, building, testing, and deploying NEAR Protocol Rust smart contracts using cargo-near.",
  "version": "0.2.2",
  "publisher": "Festivemena",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "near",
    "blockchain",
    "smart-contracts",
    "rust",
    "wasm",
    "cargo-near",
    "testnet",
    "mainnet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Festivemena/Near-Studio"
  },
  "bugs": {
    "url": "https://github.com/Festivemena/Near-Studio/issues"
  },
  "homepage": "https://github.com/Festivemena/Near-Studio#readme",
  "activationEvents": [
    "onLanguage:rust",
    "workspaceContains:**/Cargo.toml"
  ],
  "main": "./out/extension.js",
  "icon": "assets/logo.png",
  "contributes": {
    "configuration": {
      "title": "NEAR Extension",
      "properties": {
        "near-studio.accounts": {
          "type": "object",
          "default": {},
          "description": "Stored NEAR account credentials",
          "scope": "application"
        },
        "near-studio.accountId": {
          "type": "string",
          "default": "",
          "description": "Currently active NEAR account ID",
          "scope": "application"
        },
        "near-studio.network": {
          "type": "string",
          "default": "testnet",
          "enum": ["testnet", "mainnet"],
          "description": "Currently active NEAR network",
          "scope": "application"
        },
        "near-studio.autoInstallDeps": {
          "type": "boolean",
          "default": true,
          "description": "Automatically prompt to install missing dependencies",
          "scope": "application"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "near-studio-sidebar",
          "title": "NEAR Studio",
          "icon": "./assets/nearstudio.svg"
        }
      ]
    },
    "views": {
      "near-studio-sidebar": [
        {
          "type": "webview",
          "id": "near-studio.projectExplorer",
          "name": "Project Explorer",
          "when": "workspaceFolderCount > 0"
        },
        {
          "type": "webview",
          "id": "near-studio.contractManager",
          "name": "Contract Manager",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "near-studio.accountManager",
          "name": "Account Manager",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "near-studio.createContract",
        "title": "Create New Rust Contract",
        "category": "Near"
      },
      {
        "command": "near-studio.createRustContract",
        "title": "Create Rust Contract",
        "category": "Near"
      },
      {
        "command": "near-studio.buildContract",
        "title": "Build Contract",
        "category": "Near"
      },
      {
        "command": "near-studio.testContract",
        "title": "Test Contract",
        "category": "Near"
      },
      {
        "command": "near-studio.deployContract",
        "title": "Deploy Contract (Existing Account)",
        "category": "Near"
      },
      {
        "command": "near-studio.deployContractNewAccount",
        "title": "Deploy Contract (New Dev Account)",
        "category": "Near"
      },
      {
        "command": "near-studio.setupRustToolchain",
        "title": "Setup Rust Toolchain",
        "category": "Near"
      },
      {
        "command": "near-studio.refreshAccounts",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "near-studio.addAccount",
        "title": "Add Account",
        "icon": "$(add)"
      },
      {
        "command": "near-studio.createWallet",
        "title": "Create New Account",
        "category": "Near",
        "icon": "$(add)"
      },
      {
        "command": "near-studio.quickCreateTestnetAccount",
        "title": "Quick Create Testnet Account (with Faucet)",
        "category": "Near",
        "icon": "$(plus)"
      },
      {
        "command": "near-studio.importWallet", 
        "title": "Import Existing Account",
        "category": "Near",
        "icon": "$(folder-opened)"
      },
      {
        "command": "near-studio.switchAccount",
        "title": "Switch Account",
        "category": "Near",
        "icon": "$(account)"
      },
      {
        "command": "near-studio.viewAccountOnExplorer",
        "title": "View on Explorer",
        "category": "Near",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "near-studio.createContract",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "near-studio.createRustContract",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "near-studio.buildContract",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "near-studio.testContract",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "near-studio.deployContract",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "near-studio.deployContractNewAccount",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "near-studio.refreshAccounts",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "near-studio.addAccount",
          "when": "view == near-studio.accountManager",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "near-studio.viewAccountOnExplorer", 
          "when": "view == near-studio.accountManager && viewItem == account",
          "group": "inline"
        },
        {
          "command": "near-studio.switchAccount",
          "when": "view == near-studio.accountManager && viewItem == account"
        }
      ],
      "explorer/context": [
        {
          "command": "near-studio.createContract",
          "when": "explorerResourceIsFolder",
          "group": "near@1"
        },
        {
          "command": "near-studio.buildContract",
          "when": "resourceExtname == .rs",
          "group": "near@2"
        },
        {
          "command": "near-studio.testContract",
          "when": "resourceExtname == .rs",
          "group": "near@3"
        }
      ]
    },
    "snippets": [
      {
        "language": "rust",
        "path": "./snippets/rust-snippets.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "near",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Near task to execute",
            "enum": [
              "build",
              "test",
              "deploy"
            ]
          },
          "contract": {
            "type": "string",
            "description": "The contract to operate on"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0",
    "eslint": "^8.28.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "child_process": "^1.0.2",
    "node-fetch": "^3.3.2"
  },
  "extensionDependencies": [],
  "extensionPack": []
}