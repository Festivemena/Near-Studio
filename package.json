{
  "name": "near-studio",
  "displayName": "Near Studio",
  "description": "A comprehensive VS Code extension for developing, building, testing, and deploying NEAR Protocol smart contracts in Rust, JavaScript, TypeScript, and Python using create-near-app templates.",
  "version": "0.1.3",
  "publisher": "Festivemena",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "near",
    "blockchain",
    "smart-contracts",
    "rust",
    "javascript",
    "typescript",
    "python",
    "wasm",
    "wallet",
    "testnet",
    "mainnet",
    "create-near-app",
    "next.js",
    "vite",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Festivemena/Near-Studio"
  },
  "bugs": {
    "url": "https://github.com/Festivemena/Near-Studio/issues"
  },
  "homepage": "https://github.com/Festivemena/Near-Studio#readme",
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/package.json",
    "workspaceContains:**/contract.py"
  ],
  "main": "./out/extension.js",
  "icon": "assets/logo.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "near-studio-sidebar",
          "title": "NEAR Studio",
          "icon": "./assets/nearstudio.svg"
        }
      ]
    },
    "views": {
      "near-studio-sidebar": [
        {
          "type": "webview",
          "id": "near-studio.projectExplorer",
          "name": "Project Explorer",
          "when": "workspaceFolderCount > 0"
        },
        {
          "type": "webview",
          "id": "near-studio.contractManager",
          "name": "Contract Manager",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "near-studio.accountManager",
          "name": "Account Manager",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "nearExtension.createContract",
        "title": "Create New Near Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.createRustContract",
        "title": "Create Rust Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.createJSContract",
        "title": "Create JavaScript Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.createTSContract",
        "title": "Create TypeScript Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.createPythonContract",
        "title": "Create Python Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.createFrontend",
        "title": "Create Frontend",
        "category": "Near"
      },
      {
        "command": "nearExtension.buildContract",
        "title": "Build Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.deployContract",
        "title": "Deploy Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.testContract",
        "title": "Test Contract",
        "category": "Near"
      },
      {
        "command": "nearExtension.initializeProject",
        "title": "Initialize Near Project",
        "category": "Near"
      },
      {
        "command": "nearExtension.setupRustToolchain",
        "title": "Setup Rust Toolchain",
        "category": "Near"
      },
      {
        "command": "nearExtension.optimizeContract",
        "title": "Optimize Contract for Production",
        "category": "Near"
      },
      {
        "command": "nearExtension.generateBindings",
        "title": "Generate Contract Bindings",
        "category": "Near"
      },
      {
        "command": "near-studio.refreshAccounts",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "near-studio.addAccount",
        "title": "Add Account",
        "icon": "$(add)"
      },
      {
        "command": "near-studio.createWallet",
        "title": "Create New Wallet",
        "category": "Near Wallet",
        "icon": "$(add)"
      },
      {
        "command": "near-studio.importWallet",
        "title": "Import Existing Wallet",
        "category": "Near Wallet",
        "icon": "$(folder-opened)"
      },
      {
        "command": "near-studio.switchAccount",
        "title": "Switch to Account",
        "category": "Near Wallet",
        "icon": "$(account)"
      },
      {
        "command": "near-studio.switchNetwork",
        "title": "Switch Network",
        "category": "Near Wallet",
        "icon": "$(globe)"
      },
      {
        "command": "near-studio.getTestTokens",
        "title": "Get Test Tokens",
        "category": "Near Wallet",
        "icon": "$(gift)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "near-studio.refreshAccounts",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "near-studio.refreshAccounts",
          "when": "view == near-studio.accountManager",
          "group": "navigation"
        },
        {
          "command": "near-studio.addAccount",
          "when": "view == near-studio.accountManager",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "nearExtension.createContract",
          "when": "explorerResourceIsFolder",
          "group": "near@1"
        },
        {
          "command": "nearExtension.createFrontend",
          "when": "explorerResourceIsFolder",
          "group": "near@2"
        },
        {
          "command": "nearExtension.buildContract",
          "when": "resourceExtname == .rs || resourceExtname == .ts || resourceExtname == .js || resourceFilename == contract.py",
          "group": "near@3"
        },
        {
          "command": "nearExtension.testContract",
          "when": "resourceExtname == .rs || resourceExtname == .ts || resourceExtname == .js || resourceFilename == contract.py",
          "group": "near@4"
        }
      ]
    },
    "snippets": [
      {
        "language": "rust",
        "path": "./snippets/rust-snippets.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/js-snippets.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/ts-snippets.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "near",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Near task to execute",
            "enum": [
              "build",
              "test",
              "deploy",
              "optimize",
              "generate-bindings"
            ]
          },
          "contract": {
            "type": "string",
            "description": "The contract to operate on"
          },
          "language": {
            "type": "string",
            "description": "Contract language",
            "enum": [
              "rust",
              "typescript",
              "javascript",
              "python"
            ]
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0",
    "eslint": "^8.28.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "child_process": "^1.0.2",
    "node-fetch": "^3.3.2"
  },
  "extensionDependencies": [],
  "extensionPack": []
}
